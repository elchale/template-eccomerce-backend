
# Django
DJANGO_SECRET_KEY="django-secure-"
DEBUG=True

# Host domain
DOMAIN="django-template.com"
FRONTEND_DOMAIN="react-template.com"
ADDITIONAL_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PROJECT_NAME="Test"
BRAND="Test"

# API Documentation (set to False in production to disable public API docs)
ENABLE_API_DOCS=False

# Admin
# IMPORTANT: ADMIN_USER must be a valid email address — order admin notifications
# (new paid orders, status changes, amount mismatch alerts) are routed to it.
ADMIN_USER="admin@exchange.net"
ADMIN_MASTERPASS="admin_masterpass"

# Database
DB_NAME="django_template"
DB_USER="django_template"
DB_PASS="django_template"
DB_HOST="localhost"
DB_PORT=5432
DB_CONN_MAX_AGE=10

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASS=""

# Celery — set to True only when a Celery worker is actually running.
# When False, emails dispatch via a daemon thread (no broker required).
USE_CELERY=False

# RabbitMQ
AMQP_IS_EXTERNAL=True
AMQP_USER="guest"
AMQP_PASS="guest"
AMQP_HOST="localhost"
AMQP_PORT=5672

# Email
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
DEFAULT_FROM_EMAIL="from@example.com"
EMAIL_HOST="smtp.example.com"
EMAIL_HOST_USER="user@example.com"
EMAIL_HOST_PASSWORD="password"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_CONFIRMATION_EXPIRE_DAYS=1
EMAIL_CONFIRMATION_COOLDOWN=180
# SMTP socket timeout in seconds (default: 10). Prevents slow SMTP from blocking requests.
EMAIL_TIMEOUT=10

# GCS
GCS_BUCKET_NAME='your-bucket-name' # NOTE: Bucket should have Settings > Access Control > Precise
GCS_CREDENTIALS_PATH='path/to/your/service-account-key.json'
GCS_PROJECT_ID='your-project-id'

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ── Payment gateway selection ───────────────────────────────────────────────
# Active gateway: "mercadopago" (default), "culqi" or "izipay". Culqi and
# Izipay code is kept dormant — selectable again by flipping this flag.
PAYMENT_GATEWAY=mercadopago

# Mercado Pago payment gateway (ACTIVE) — shared "Qolca Solutions" account.
# Get credentials from the MP panel: https://www.mercadopago.com.pe/developers/panel
# → "Tus integraciones" → Credenciales (test/prod). Use APP_USR-… in both
# environments; the test prefix on the access token implies sandbox.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Webhook secret. Source: MP panel → Webhooks → "Clave secreta". Empty is
# allowed (signature checks are then skipped — useful for local dev), but in
# production this MUST be set so /pay rejects forged notifications.
MERCADOPAGO_WEBHOOK_SECRET=

# Culqi payment gateway (DORMANT — kept for fallback, not used while
# PAYMENT_GATEWAY=mercadopago) — shared "Qolca Solutions" account.
# Get keys from CulqiPanel: https://culqipanel.culqi.com > Desarrollo > API Keys
# Use pk_test_/sk_test_ in development and pk_live_/sk_live_ in production.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Random unguessable slug for the webhook URL path. Generate one (e.g.
# `python -c "import secrets;print(secrets.token_urlsafe(24))"`) and register
# https://<backend-domain>/api/payments/culqi/webhook-<slug>/ in CulqiPanel.
CULQI_WEBHOOK_PATH_SECRET=

# Izipay / Lyra payment gateway (DORMANT — kept for fallback, not used while
# PAYMENT_GATEWAY=mercadopago). Credentials: https://secure.micuentaweb.pe
# Reuses impresiones' shop ID 36933364. Only the order-number prefix differs (QLCA vs IMP).
# Source of truth for values: impresiones/backend/.env (IZIPAY_*)
IZIPAY_SHOP_ID=36933364
IZIPAY_MODE=TEST                              # TEST or PRODUCTION
IZIPAY_API_KEY_TEST=                          # copy from impresiones .env
IZIPAY_API_KEY_PROD=                          # copy from impresiones .env
IZIPAY_HMAC_KEY_TEST=                         # copy from impresiones .env
IZIPAY_HMAC_KEY_PROD=                         # copy from impresiones .env
TRUST_PROXY=False                             # True only when behind Render/Railway/CF