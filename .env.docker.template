# Template for the docker-compose stack. Copy to .env.docker and fill in the
# integration secrets. Service hostnames (db, redis, rabbitmq) match the
# compose service names — do not change them unless you also rename the
# services in docker-compose.yml.

# ---- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-do-not-use-in-prod-1234567890abcdef
DEBUG=True
DOMAIN=localhost
FRONTEND_DOMAIN=localhost:5173
ADDITIONAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROJECT_NAME=Eccomerce
BRAND=Eccomerce
ENABLE_API_DOCS=True

# ---- Admin ------------------------------------------------------------------
# IMPORTANT: ADMIN_USER must be a valid email address — order admin notifications
# (new paid orders, status changes, amount mismatch alerts) are routed to it.
ADMIN_USER=admin@example.com
ADMIN_MASTERPASS=changeme

# ---- Database (matches db service in docker-compose.yml) --------------------
DB_NAME=eccomerce
DB_USER=eccomerce
DB_PASS=eccomerce
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=10

# ---- Redis (matches redis service) ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=

# ---- Celery ------------------------------------------------------------------
# Set to True only when a Celery worker is actually running.
# When False, emails dispatch via a daemon thread (no broker required).
USE_CELERY=False

# ---- RabbitMQ (matches rabbitmq service) ------------------------------------
# AMQP_IS_EXTERNAL=False makes Celery use plain amqp:// (no TLS) — required
# for the in-cluster RabbitMQ. Flip to True when pointing at a hosted broker.
AMQP_IS_EXTERNAL=False
AMQP_USER=guest
AMQP_PASS=guest
AMQP_HOST=rabbitmq
AMQP_PORT=5672

# ---- Email (console backend for local dev) ----------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_CONFIRMATION_EXPIRE_DAYS=1
EMAIL_CONFIRMATION_COOLDOWN=180
# SMTP socket timeout in seconds (default: 10)
EMAIL_TIMEOUT=10

# ---- Google Cloud Storage ---------------------------------------------------
# For local-only file uploads, leave empty and avoid upload endpoints.
# For real GCS access, set either GCS_CREDENTIALS_JSON (base64 of the key
# file) or mount the key and point GCS_CREDENTIALS_PATH at it.
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CREDENTIALS_JSON=
GCS_CREDENTIALS_PATH=

# ---- Google OAuth -----------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Izipay / Lyra payment gateway ------------------------------------------
IZIPAY_SHOP_ID=36933364
IZIPAY_MODE=TEST
IZIPAY_API_KEY_TEST=
IZIPAY_API_KEY_PROD=
IZIPAY_HMAC_KEY_TEST=
IZIPAY_HMAC_KEY_PROD=
TRUST_PROXY=False

# Test secret key for local stack
